{
	"name": "webcomms-panel",
	"version": "2.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-webcomms-panel.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.14.1",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@companion-module/tools": "2.7.1",
		"@types/node": "^22",
		"eslint": "^9.36.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.4",
		"rimraf": "^6.1.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.59.0"
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSpacing": true,
		"printWidth": 120,
		"semi": false,
		"singleQuote": true,
		"useTabs": true,
		"endOfLine": "auto"
	},
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.13.0"
}
